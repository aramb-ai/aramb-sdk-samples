# Copy to .env.local (ignored by git) and fill in. Never commit real values.

# Your aramb builder key (server only; never sent to the browser).
ARAMB_KEY=
# The aramb gateway. The default is the hosted one.
ARAMB_BASE_URL=https://api.aramb.ai/gw

# Auth.js: a random secret (`npx auth secret` prints one).
AUTH_SECRET=
# Google sign-in (OAuth client of your Google Cloud project).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email-only dev login. 1 is allowed only with NODE_ENV=development or test;
# with any other NODE_ENV the app refuses to start.
ALLOW_DEV_LOGIN=0

# Comma-separated emails of company admins (company domains only).
ADMIN_EMAILS=

# Written by `npm run setup`.
SUPPORT_AGENT_ID=
BILLING_AGENT_ID=
